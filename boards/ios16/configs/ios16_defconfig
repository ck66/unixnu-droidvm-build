# iOS 16 (xnu-8796) kernel configuration for the DroidVM guest: crosvm on Gunyah, SM8650.
#
# Derived from N1709/UniXNU-whyred's configs/whyred_defconfig (the only published iOS 16
# board that gets as far as a kernel) with the two board-specific bits changed:
#   - no CONFIG_XNU_NATIVE_PAN=n: Kryo 260 is ARMv8.0 and cannot run the PAN sequence,
#     SM8650 is ARMv8.7 and does have PSTATE.PAN;
#   - CONFIG_XNU_BUILD_ARCHIVES=y, because this board's archives (board.toml [kernel]
#     archives) are how corecrypto/pthread/AES/ArmCpu enter the link.
#
# The OS layer's own fragment (os:configs/ios.config in S7) is already folded in here:
# TRUST_CACHE_RUNTIME, SOURCE_MOCKFS, NATIVE_CS_HASH_CACHE, CRYPTO_BOOTSTRAP="prelinked".
#
# First milestone was a kernel. It boots: AMFI is past, PE_init returns, IOCatalogue
# builds, and the only remaining panic is "Failed to mount root device" -- because the
# board had no storage transport at all. ios16's KernelConfigTables.cpp already carries
# the `XNU_NATIVE_VIRTIO_BLOCK` personality (IOClass NativeVirtioBlock over
# IOPlatformDevice), and build-xnu-4k-baseline.sh force-loads
# build/virtio-mmio-block/libVirtioMmioBlock.a when this is 1, so storage is one switch
# plus one archive builder (boards/ios16/make-board.py). Display, GPU and owner-root stay
# off for now, as the whyred board has them.
CONFIG_XNU_BUILD_ARCHIVES=y
CONFIG_XNU_NATIVE_VIRTIO_BLOCK=y
CONFIG_XNU_ARM_DT_PLATFORM=y
CONFIG_XNU_ARMCPU=y
CONFIG_XNU_SOURCE_CORECRYPTO14=y
CONFIG_XNU_SOURCE_PTHREAD=y
CONFIG_XNU_NATIVE_AES=y
CONFIG_XNU_NATIVE_ARCH_TIMER=y
CONFIG_XNU_TRUST_CACHE_RUNTIME=y
# BCM2837.h's PLATFORM_PANIC_LOG_PADDR is 0x3c0fc000, which is no RAM in this guest: the kernel
# mapped it as the panic log and every panic (and the console buffer that shares the region) was
# unreadable/faulting. With the DT region on, pe_init takes /pram + /chosen/embedded-panic-log-size
# from make-droidvm-adt.py instead, i.e. the top 512 KiB of guest RAM -- the region p3peek --panic reads.
CONFIG_XNU_DT_PANIC_REGION=y
# 8796's public mockfs sources are incomplete (mockfs_fsnode.c needs the private enum) and this
# board mounts the payload's real APFS volumes; fixup-8796.py also turns the four #if MOCKFS
# blocks in vfs_conf.c off. build-xnu-4k-baseline.sh otherwise insists on libmockfs_fixture.a.
CONFIG_XNU_SOURCE_MOCKFS=n
CONFIG_XNU_NATIVE_CS_HASH_CACHE=y
CONFIG_XNU_CRYPTO_BOOTSTRAP="prelinked"

CONFIG_XNU_NATIVE_UFS=n
CONFIG_XNU_NATIVE_ADRENO=n
CONFIG_XNU_NATIVE_MOBILE_DISPLAY=n
CONFIG_XNU_ARMVIRT_PLATFORM=n

# Offline owner / SystemOS chain.  Without it launchd stops at the Image4 ignition query
# (AppleImage4 waits for a service this VM never publishes), and even when that query is
# stubbed, dyld cannot find libSystem.B.dylib: the shared cache lives in the SystemOS
# cryptex, not on the root volume.  The UniXNU owner patches are already applied by
# build-xnu-4k-baseline.sh (whyred carries offline-owner-systemos-mount.patch); these
# switches compile them in, mount the cryptex at /private/preboot before launchd, and set
# commpage dyld flag bit 3 ("no ignition").  build-xnu-4k-baseline.sh enforces the chain
# VERIFIED_ROOT_PROBE -> OWNER_ROOT_AUDIT -> OWNER_ROOT_TRUST -> CACHE_MOUNT ->
# CACHE_STARTUP -> CRYPTEX_FILES, so all six are required.  The two missing bsd_init.c
# patches and the verified-block shims come from boards/ios16/patches/xnu-owner/.
CONFIG_XNU_VERIFIED_ROOT_PROBE=y
CONFIG_XNU_OWNER_ROOT_AUDIT=y
CONFIG_XNU_OWNER_ROOT_TRUST=y
CONFIG_XNU_OWNER_CACHE_MOUNT=y
CONFIG_XNU_OWNER_CACHE_STARTUP=y
CONFIG_XNU_OWNER_CRYPTEX_FILES=y
# Measured from systemos.img's APFS volume superblock (APSB +0xe0): whyred's default
# 8846FE78-... is the macOS/Sheng image and does not exist on this iOS 16.7.16 cryptex.
CONFIG_XNU_OWNER_CACHE_VOLUME_UUID="96096B28-B6DC-4BC7-9D3A-2632A0FE53F1"
