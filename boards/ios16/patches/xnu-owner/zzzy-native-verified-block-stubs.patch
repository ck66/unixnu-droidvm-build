+/*
+ * Offline owner verified-block shims (DroidVM / iOS 16 board).
+ *
+ * offline-owner-systemos-mount.patch (kern_exec.c) and
+ * offline-owner-root-binding-audit.patch (bsd_init.c) call these.  Their production
+ * implementations live in the out-of-tree verified-block storage which this board does
+ * not link, and a VM has no sealed, hardware-authenticated root: the virtio-mmio disks
+ * themselves are the trust boundary.  So accept any mounted media, and resolve the
+ * SystemOS cryptex by its APFS volume UUID (XNU_OWNER_CACHE_VOLUME_UUID, measured from
+ * systemos.img's APSB).  If 8796 does not publish the UUID property on IOMedia, fall back
+ * to the first non-root whole disk -- crosvm publishes SystemOS on the second transport.
+ */
+extern "C" dev_t rootdev;
+
+extern "C" int
+native_verified_block_root_authorized(dev_t device)
+{
+	return device != NODEV;
+}
+
+extern "C" int
+native_verified_block_volume_device(const char *volume_uuid, dev_t *device,
+    char *path, size_t path_size)
+{
+	OSDictionary *matching;
+	OSPtr<OSIterator> iterator;
+	IORegistryEntry *media;
+	OSNumber *major, *minor;
+	OSString *bsd_name, *media_uuid;
+	dev_t candidate = NODEV, fallback = NODEV;
+	char candidate_path[64] = {0}, fallback_path[64] = {0};
+	int exact = 0;
+
+	if (device == NULL || path == NULL || path_size < 16) {
+		return 0;
+	}
+	matching = IOService::serviceMatching("IOMedia");
+	if (matching == NULL) {
+		return 0;
+	}
+	iterator = IOService::getMatchingServices(matching);
+	if (!iterator) {
+		return 0;
+	}
+	while ((media = OSDynamicCast(IORegistryEntry, iterator->getNextObject())) != NULL) {
+		major = OSDynamicCast(OSNumber, media->getProperty(kIOBSDMajorKey));
+		minor = OSDynamicCast(OSNumber, media->getProperty(kIOBSDMinorKey));
+		bsd_name = OSDynamicCast(OSString, media->getProperty(kIOBSDNameKey));
+		if (major == NULL || minor == NULL || bsd_name == NULL) {
+			continue;
+		}
+		candidate = makedev(major->unsigned32BitValue(), minor->unsigned32BitValue());
+		strlcpy(candidate_path, "/dev/", sizeof(candidate_path));
+		strlcat(candidate_path, bsd_name->getCStringNoCopy(), sizeof(candidate_path));
+		media_uuid = OSDynamicCast(OSString, media->getProperty("UUID"));
+		if (volume_uuid != NULL && media_uuid != NULL &&
+		    strcmp(media_uuid->getCStringNoCopy(), volume_uuid) == 0) {
+			exact = 1;
+			break;
+		}
+		if (fallback == NODEV && candidate != rootdev) {
+			fallback = candidate;
+			strlcpy(fallback_path, candidate_path, sizeof(fallback_path));
+		}
+	}
+	if (!exact && fallback == NODEV) {
+		IOLog("owner: no IOMedia for SystemOS UUID %s\n",
+		    volume_uuid ? volume_uuid : "(unset)");
+		return 0;
+	}
+	*device = exact ? candidate : fallback;
+	strlcpy(path, exact ? candidate_path : fallback_path, path_size);
+	IOLog("owner: SystemOS %s -> %s\n", exact ? "UUID match" : "fallback", path);
+	return 1;
+}
+
+
+/* XNU_VERIFIED_ROOT_PROBE's probe lives in the out-of-tree verified-root kit, which
+ * this board does not link.  bsd_init.c only reaches it when the boot arg
+ * offline-owner-root-check=1 is set, so a no-op stub is enough. */
+extern "C" void
+native_verified_root_probe(void)
+{
+	IOLog("owner: no verified-root backend in the DroidVM guest\n");
+}
+
+
+/* XNU_OWNER_BOOT_MANIFEST's publisher is part of the same out-of-tree owner kit.
+ * 8796 calls it as (root device, root uuid, cache device, cache uuid) and treats a
+ * zero return as EAUTH.  The guest has no authenticated manifest to publish -- the
+ * virtio-mmio disks are its trust boundary -- so record what was asked for, derive a
+ * stable 48-byte value from the two volume UUIDs, and accept.  The globals keep the
+ * result inspectable from the host (see .tmp/guestps.py/gpeek usage notes). */
+volatile int native_owner_boot_manifest_status = -1;
+uint8_t native_owner_boot_manifest_hash[48];
+
+extern "C" int
+native_owner_publish_boot_manifest(dev_t root_device, const char *root_uuid,
+    dev_t cache_device, const char *cache_uuid)
+{
+	const char *a = root_uuid ? root_uuid : "";
+	const char *b = cache_uuid ? cache_uuid : "";
+	uint32_t h = 2166136261u;
+	size_t i;
+
+	for (i = 0; a[i] != '\0'; i++) {
+		h = (h ^ (uint8_t)a[i]) * 16777619u;
+	}
+	for (i = 0; b[i] != '\0'; i++) {
+		h = (h ^ (uint8_t)b[i]) * 16777619u;
+	}
+	for (i = 0; i < sizeof(native_owner_boot_manifest_hash); i++) {
+		h = (h ^ (uint32_t)i) * 16777619u;
+		native_owner_boot_manifest_hash[i] = (uint8_t)(h >> 24);
+	}
+	native_owner_boot_manifest_status = 0;
+	IOLog("owner: boot manifest shim root=%d cache=%d uuid=%s\n",
+	    (int)root_device, (int)cache_device, b);
+	return 1;
+}
+
+
+
+
+
+/* XNU_OWNER_DATA_MOUNT's device resolution.
+ *
+ * The scratch Data seed reaches the guest as /chosen/memory-map/PackedRAMDisk
+ * (DarwinBoot keeps the DBRDISK1 pack; stock XNU only ever looks for "RAMDisk"),
+ * so mdev0 does not exist and mdevlookup(0) returns NODEV.
+ *
+ * Resolve the Data media off the virtio disk instead.  Two passes:
+ *   1. an IOMedia whose "UUID" equals the Data volume UUID (case-insensitive --
+ *      the APFS kext and this string do not have to agree on case), and
+ *   2. otherwise the partition media that is exactly 32 MiB, which is what
+ *      data-disk.img carries (GPT partition 1, an APFS container of 8192 4K blocks).
+ * Pass 2 exists because the fixture volume is named "OwnerData" with apfs_role 0 and
+ * this XNU does not always publish a UUID property for it. */
+#define NATIVE_DATA_PARTITION_BYTES 33554432ULL
+
+static int
+native_owner_data_match_uuid(OSString *media_uuid, const char *volume_uuid)
+{
+	const char *a, *b;
+
+	if (media_uuid == NULL || volume_uuid == NULL) {
+		return 0;
+	}
+	a = media_uuid->getCStringNoCopy();
+	b = volume_uuid;
+	while (*a != '\0' && *b != '\0') {
+		char ca = *a++, cb = *b++;
+		if (ca >= 'a' && ca <= 'z') ca = (char)(ca - 'a' + 'A');
+		if (cb >= 'a' && cb <= 'z') cb = (char)(cb - 'a' + 'A');
+		if (ca != cb) {
+			return 0;
+		}
+	}
+	return *a == '\0' && *b == '\0';
+}
+
+extern "C" int
+native_owner_data_media(const char *volume_uuid, dev_t *device, char *path, size_t path_size)
+{
+	OSDictionary *matching;
+	OSPtr<OSIterator> iterator;
+	IORegistryEntry *media;
+	OSNumber *major, *minor, *size_prop;
+	OSString *bsd_name, *media_uuid;
+	dev_t by_size = NODEV;
+	char by_size_path[64] = {0};
+
+	extern void native_owner_dump_media(void);
+	if (device == NULL || path == NULL || path_size < 16) {
+		return 0;
+	}
+	native_owner_dump_media();
+	matching = IOService::serviceMatching("IOMedia");
+	if (matching == NULL) {
+		return 0;
+	}
+	iterator = IOService::getMatchingServices(matching);
+	if (!iterator) {
+		return 0;
+	}
+	while ((media = OSDynamicCast(IORegistryEntry, iterator->getNextObject())) != NULL) {
+		major = OSDynamicCast(OSNumber, media->getProperty(kIOBSDMajorKey));
+		minor = OSDynamicCast(OSNumber, media->getProperty(kIOBSDMinorKey));
+		bsd_name = OSDynamicCast(OSString, media->getProperty(kIOBSDNameKey));
+		if (major == NULL || minor == NULL || bsd_name == NULL) {
+			continue;
+		}
+		media_uuid = OSDynamicCast(OSString, media->getProperty("UUID"));
+		if (native_owner_data_match_uuid(media_uuid, volume_uuid)) {
+			*device = makedev(major->unsigned32BitValue(), minor->unsigned32BitValue());
+			strlcpy(path, "/dev/", path_size);
+			strlcat(path, bsd_name->getCStringNoCopy(), path_size);
+			IOLog("owner: Data media by uuid -> %s\n", path);
+			return 1;
+		}
+		if (by_size == NODEV) {
+			size_prop = OSDynamicCast(OSNumber, media->getProperty("Size"));
+			if (size_prop != NULL && size_prop->unsigned64BitValue() == NATIVE_DATA_PARTITION_BYTES) {
+				by_size = makedev(major->unsigned32BitValue(), minor->unsigned32BitValue());
+				strlcpy(by_size_path, "/dev/", sizeof(by_size_path));
+				strlcat(by_size_path, bsd_name->getCStringNoCopy(), sizeof(by_size_path));
+			}
+		}
+	}
+	if (by_size != NODEV) {
+		*device = by_size;
+		strlcpy(path, by_size_path, path_size);
+		IOLog("owner: Data media by size -> %s\n", path);
+		return 1;
+	}
+	IOLog("owner: no Data media (uuid %s, size %llu)\n", volume_uuid ? volume_uuid : "(unset)",
+	    (unsigned long long)NATIVE_DATA_PARTITION_BYTES);
+	return 0;
+}
+
+
+
+/* One-shot inventory of every IOMedia, so a failed Data match reports what the
+ * guest actually has instead of leaving us to guess (run77 matched nothing).
+ * Read it back with:  python .tmp/memgrep.py "owner-media:" */
+extern "C" void
+native_owner_dump_media(void)
+{
+	static int done = 0;
+	OSDictionary *matching;
+	OSPtr<OSIterator> iterator;
+	IORegistryEntry *media;
+	OSNumber *major, *minor, *size_prop;
+	OSString *bsd_name, *media_uuid;
+	int shown = 0;
+
+	if (done) {
+		return;
+	}
+	done = 1;
+	matching = IOService::serviceMatching("IOMedia");
+	if (matching == NULL) {
+		return;
+	}
+	iterator = IOService::getMatchingServices(matching);
+	if (!iterator) {
+		return;
+	}
+	while ((media = OSDynamicCast(IORegistryEntry, iterator->getNextObject())) != NULL && shown < 16) {
+		const char *name = "?";
+		const char *uuid = "-";
+		unsigned long long size = 0;
+		int maj = -1, min = -1;
+
+		bsd_name = OSDynamicCast(OSString, media->getProperty(kIOBSDNameKey));
+		if (bsd_name != NULL) {
+			name = bsd_name->getCStringNoCopy();
+		}
+		size_prop = OSDynamicCast(OSNumber, media->getProperty("Size"));
+		if (size_prop != NULL) {
+			size = size_prop->unsigned64BitValue();
+		}
+		media_uuid = OSDynamicCast(OSString, media->getProperty("UUID"));
+		if (media_uuid != NULL) {
+			uuid = media_uuid->getCStringNoCopy();
+		}
+		major = OSDynamicCast(OSNumber, media->getProperty(kIOBSDMajorKey));
+		minor = OSDynamicCast(OSNumber, media->getProperty(kIOBSDMinorKey));
+		if (major != NULL) {
+			maj = (int)major->unsigned32BitValue();
+		}
+		if (minor != NULL) {
+			min = (int)minor->unsigned32BitValue();
+		}
+		IOLog("owner-media: %s maj=%d min=%d size=%llu uuid=%s\n", name, maj, min, size, uuid);
+		shown++;
+	}
+	IOLog("owner-media: end (%d entries)\n", shown);
+}
+
