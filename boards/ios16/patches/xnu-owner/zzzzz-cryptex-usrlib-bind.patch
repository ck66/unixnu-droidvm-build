+		native_owner_cache_bind_lookup = vnode_lookup(lower, 0, &tvp, vfs_context_current());
+		if (tvp != NULLVP) { vnode_put(tvp); tvp = NULLVP; }
+		snprintf(lower, sizeof(lower), "%s/usr/lib/libobjc-trampolines.dylib", mountpoint);
+		native_owner_cache_bind_file = vnode_lookup(lower, 0, &tvp, vfs_context_current());
+		if (tvp != NULLVP) { vnode_put(tvp); tvp = NULLVP; }
+		snprintf(lower, sizeof(lower), "%s/usr/lib/dyld", mountpoint);
+		native_owner_cache_bind_dyld = vnode_lookup(lower, 0, &tvp, vfs_context_current());
+		if (tvp != NULLVP) { vnode_put(tvp); tvp = NULLVP; }
+		snprintf(lower, sizeof(lower), "%s/usr/lib/libSystem.B.dylib", mountpoint);
+		native_owner_cache_bind_libsystem = vnode_lookup(lower, 0, &tvp, vfs_context_current());
+		if (tvp != NULLVP) { vnode_put(tvp); tvp = NULLVP; }
+		snprintf(lower, sizeof(lower), "%s/usr/lib/dyld", mountpoint);
+		native_owner_cache_bind_dyld = vnode_lookup(lower, 0, &tvp, vfs_context_current());
+		if (tvp != NULLVP) { vnode_put(tvp); tvp = NULLVP; }
+		snprintf(lower, sizeof(lower), "%s/usr/lib/libSystem.B.dylib", mountpoint);
+		native_owner_cache_bind_libsystem = vnode_lookup(lower, 0, &tvp, vfs_context_current());
+		if (tvp != NULLVP) { vnode_put(tvp); tvp = NULLVP; }
