--- a/bsd/kern/kern_exec.c
+++ b/bsd/kern/kern_exec.c
@@ -6873,6 +6873,30 @@
 	cache_authorized = cache_authorized && native_union;
 #endif
 	if (!cache_authorized) { error = EAUTH; goto done; }
+	/*
+	 * DroidVM: /usr/lib/libobjc-trampolines.dylib lives in the cryptex and never appears
+	 * under the root's /usr/lib here, because the bindfs glue that normally mirrors the
+	 * cryptex directories onto the root is not running.  libobjc dlopen()s that dylib by
+	 * absolute path the first time a class needs an IMP trampoline, and on failure it
+	 * aborts the process -- which is what was killing SpringBoard, powerd, chronod,
+	 * CommCenter and the rest with OS_REASON_OBJC.  Mirror the one directory that matters
+	 * while still in launchd's exec path, where the bindfs entitlement is held.
+	 */
+	if (mountpoint && !strcmp(mountpoint, "/private/preboot") &&
+	    !vnode_lookup("/usr/lib", 0, &mounted_root, vfs_context_current())) {
+		char lower[128];
+		struct mount_args breq = {.type = scratch + 0x100, .path = scratch + 0x120,
+		    .flags = MNT_RDONLY, .data = scratch + 0x200};
+		int bind_result = 0;
+		vnode_put(mounted_root);
+		mounted_root = NULLVP;
+		snprintf(lower, sizeof(lower), "%s/usr/lib", mountpoint);
+		if (copyout("bindfs", breq.type, 7) == 0 &&
+		    copyout("/usr/lib", breq.path, 9) == 0 &&
+		    copyout(lower, breq.data, strlen(lower) + 1) == 0) {
+			(void)mount(p, &breq, &bind_result);
+		}
+	}
 	native_owner_cache_stage = 5;
 #if !defined(XNU_OWNER_UNION_SYSTEMOS) || !XNU_OWNER_UNION_SYSTEMOS
 	if ((error = copyout(environment, environment_vector[0], strlen(environment) + 1)) != 0 ||
