+	/*
+	 * DroidVM: /usr/lib/libobjc-trampolines.dylib lives in the cryptex, and the bindfs glue
+	 * that normally mirrors the cryptex directories onto the root is not running here, so
+	 * libobjc's absolute dlopen of that path fails and it aborts the process -- which is what
+	 * was killing SpringBoard, powerd, chronod, CommCenter and the rest (OS_REASON_OBJC,
+	 * signal 6).  Mirror the directory while still inside launchd's exec path, and record
+	 * what happened so the outcome is visible from the host without another round trip.
+	 */
+	{
+		char lower[160];
+		vnode_t tvp = NULLVP;
+		struct mount_args breq = {.type = scratch + 0x100, .path = scratch + 0x120,
+		    .flags = MNT_RDONLY, .data = scratch + 0x200};
+		snprintf(lower, sizeof(lower), "%s/usr/lib", mountpoint);
+		native_owner_cache_bind_lookup = vnode_lookup(lower, 0, &tvp, vfs_context_current());
+		if (tvp != NULLVP) { vnode_put(tvp); tvp = NULLVP; }
+		snprintf(lower, sizeof(lower), "%s/usr/lib/libobjc-trampolines.dylib", mountpoint);
+		native_owner_cache_bind_file = vnode_lookup(lower, 0, &tvp, vfs_context_current());
+		if (tvp != NULLVP) { vnode_put(tvp); tvp = NULLVP; }
+		if (native_owner_cache_bind_lookup == 0 && native_owner_cache_bind_file == 0) {
+			int bind_result = 0;
+			int bind_flags = 0;
+			snprintf(lower, sizeof(lower), "%s/usr/lib", mountpoint);
+			if (copyout("bindfs", breq.type, 7) == 0 &&
+			    copyout("/usr/lib", breq.path, 9) == 0 &&
+			    copyout(lower, breq.data, strlen(lower) + 1) == 0) {
+				bind_result = mount(p, &breq, &bind_flags);
+			}
+			native_owner_cache_bind_status = bind_result;
+		}
+	}
