+volatile int native_owner_cache_bind_lookup = -1;   /* vnode_lookup(<cryptex>/usr/lib) */
+volatile int native_owner_cache_bind_file = -1;     /* vnode_lookup(.../libobjc-trampolines.dylib) */
+volatile int native_owner_cache_bind_status = -1;   /* mount("bindfs") result */
