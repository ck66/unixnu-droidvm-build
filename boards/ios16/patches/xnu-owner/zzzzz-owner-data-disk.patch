--- a/bsd/kern/kern_exec.c
+++ b/bsd/kern/kern_exec.c
@@ -6931,6 +6931,19 @@
 uint8_t native_owner_data_seed_sha256[32];
 char native_owner_data_device_path[64];
 
+/* Diagnostic scratch for the scratch-Data mount: the mount point lookup, the device
+ * lookup, whether the node had to be published, and the mount status.  Negative means
+ * "not reached yet". */
+volatile int native_owner_data_mnt_lookup = -1;
+volatile int native_owner_data_dev_lookup = -1;
+volatile int native_owner_data_node_made = -1;
+volatile int native_owner_data_mount_status = -1;
+/* The md0 window's own container header, so the host can tell "DarwinBoot expanded our
+ * seed" from "the media holds something else": NXSB, block size, block count. */
+volatile uint32_t native_owner_data_nx_magic;
+volatile uint32_t native_owner_data_nx_block_size;
+volatile uint64_t native_owner_data_nx_block_count;
+
 static int
 native_owner_data_prepare(proc_t p, user_addr_t scratch)
 {
@@ -6950,6 +6963,24 @@
 	device = mdevlookup(0);
 	if (device == NODEV || mdevgetrange(0, &base, &size) || base < VM_MIN_KERNEL_ADDRESS ||
 	    !size || size > UINT64_C(0x80000000) || (base & 4095) || (size & 4095)) goto done;
+	/* apfs_vfsop_mount picks the volume from the device name's slice index ("disk3s1"
+	 * is volume 1 of its container) and rejects a plain "md0" with ENOENT --
+	 * "invalid fsindex: -1".  Publish the same dev_t under both the container and the
+	 * slice name it would have had, and hand apfs the slice path only: a first failed
+	 * attempt leaves the container state poisoned for the same dev_t, so there is
+	 * exactly one mount call per boot. */
+	{
+		extern void *devfs_make_node(dev_t, int, uid_t, gid_t, int, const char *, ...);
+		void *container_node = devfs_make_node(device, 1 /* DEVFS_BLOCK */, 0, 0, 0600,
+		    "disk9");
+		void *slice_node = devfs_make_node(device, 1 /* DEVFS_BLOCK */, 0, 0, 0600,
+		    "disk9s1");
+		native_owner_data_node_made = (slice_node != NULL) ? 1 : 0;
+		if (container_node == NULL || slice_node == NULL) {
+			native_owner_data_node_made = -2;
+		}
+		strlcpy(device_path, "/dev/disk9s1", sizeof(device_path));
+	}
 	SHA256_CTX context;
 	SHA256_Init(&context);
 	SHA256_Update(&context, (const void *)base, size);
@@ -6959,6 +6990,19 @@
 	native_owner_data_seed_size = size;
 	native_owner_data_stage = 1;
 	strlcpy(native_owner_data_device_path, device_path, sizeof(native_owner_data_device_path));
+	native_owner_data_nx_magic = *(const volatile uint32_t *)(uintptr_t)(base + 0x20);
+	native_owner_data_nx_block_size = *(const volatile uint32_t *)(uintptr_t)(base + 0x24);
+	native_owner_data_nx_block_count = *(const volatile uint64_t *)(uintptr_t)(base + 0x28);
+	{
+		vnode_t probe_vp = NULLVP;
+		native_owner_data_mnt_lookup = vnode_lookup("/private/var", 0, &probe_vp,
+		    vfs_context_current());
+		if (probe_vp != NULLVP) vnode_put(probe_vp);
+		probe_vp = NULLVP;
+		native_owner_data_dev_lookup = vnode_lookup(device_path, 0, &probe_vp,
+		    vfs_context_current());
+		if (probe_vp != NULLVP) vnode_put(probe_vp);
+	}
 	uint8_t payload[0x150] = {0};
 	user64_addr_t spec = scratch + 0x160;
 	uint16_t mode = 1;
@@ -6976,6 +7020,7 @@
 	    (error = copyout(payload, request.data, sizeof(payload)))) goto done;
 	native_owner_data_stage = 2;
 	error = mount(p, &request, &result);
+	native_owner_data_mount_status = error;
 	if (error) goto done;
 	native_owner_data_stage = 3;
 	error = vnode_lookup("/private/var", 0, &data_root, vfs_context_current());
